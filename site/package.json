{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 4791",
    "build": "nuxt build",
    "postinstall": "nuxt prepare",
    "db:generate": "vitehub db generate",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json",
    "deploy": "pnpm build && pnpm release",
    "release": "pnpm db:migrate:remote && wrangler deploy --config .output/server/wrangler.json"
  },
  "dependencies": {
    "@comark/vue": "0.9.0",
    "@iconify-json/lucide": "^1.2.149",
    "@iconify-json/ph": "^1.2.2",
    "@nuxt/ui": "4.12.0",
    "@vite-hub/agent": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/agent@a7f259c52a32985c45d3078784b5dd16c303ef8b",
    "@vite-hub/cms": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/cms@a7f259c52a32985c45d3078784b5dd16c303ef8b",
    "@vite-hub/ui": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/ui@a7f259c52a32985c45d3078784b5dd16c303ef8b",
    "ai": "^7.0.0",
    "comark": "0.9.0",
    "comark-ui": "0.10.0",
    "drizzle-orm": "0.45.4",
    "h3": "2.0.8",
    "nitro": "3.0.261103-rc",
    "nuxt": "npm:nuxt-nightly@5.0.0-2611070044-e3875e8",
    "tailwindcss": "^4.1.0",
