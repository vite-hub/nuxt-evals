{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 4791",
    "build": "nuxt build",
    "postinstall": "nuxt prepare",
    "db:generate": "vitehub database generate",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json",
    "deploy": "pnpm build && pnpm release",
    "release": "pnpm db:migrate:remote && wrangler deploy --config .output/server/wrangler.json"
  },
