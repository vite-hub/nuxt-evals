# Model access. Set ANTHROPIC_API_KEY for the judge and the summary (Opus 5.5) and for Claude Code agents, and
# OPENAI_API_KEY for Codex agents. A *_BASE_URL points that harness at any compatible endpoint instead.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Or a CLIProxy (https://github.com/router-for-me/CLIProxyAPI), which serves both harnesses with subscription logins.
# When both are set, the CLIProxy wins over the keys above.
# CLIPROXY_URL=http://127.0.0.1:8317
# CLIPROXY_API_KEY=

# `evals push` sends runs to this site. Run your own with `pnpm dev:site`; NUXT_INGEST_TOKEN in site/.env must match.
SITE_URL=http://127.0.0.1:4791
INGEST_TOKEN=
