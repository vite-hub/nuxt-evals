# Model access goes through a ViteHub AI gateway: https://vitehub.dev/docs/gateways
# Without EVALS_GATEWAY, Claude Code (agents, the judge and the summary) uses Anthropic and Codex uses OpenAI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Or one gateway for every harness, with the variables its preset reads: anthropic, openai, cliproxy (subscription
# logins), openrouter, vercel, litellm, ollama, google, moonshot, zai, deepseek, minimax, alibaba or cloudflare.
# EVALS_GATEWAY=cliproxy
# CLIPROXY_URL=http://127.0.0.1:8317
# CLIPROXY_API_KEY=

# Other harnesses (--agent gemini, opencode, pi, kimi) go through EVALS_GATEWAY too. Without it, Gemini CLI uses the
# google preset, OpenCode and Pi openrouter, and Kimi Code moonshot. Install their CLIs into cli/.data/tools, as
# `pnpm evals hello --agent <harness>` says. Cursor, Grok and the rest sign in with their own key:
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=
# CURSOR_API_KEY=
# XAI_API_KEY=

# The judge's model id, when the gateway names Opus 5.5 differently (OpenRouter, Vercel).
# JUDGE_MODEL=claude-opus-5-5

# `evals push` sends runs to this site. Run your own with `pnpm dev:site`; NUXT_INGEST_TOKEN in site/.env must match.
SITE_URL=http://127.0.0.1:4791
INGEST_TOKEN=
