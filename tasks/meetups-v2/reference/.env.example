# Signs session cookies. Required in production: openssl rand -hex 32
BETTER_AUTH_SECRET=

# The public origin. Required in production behind an HTTPS proxy (auth origin check, Secure cookie,
# canonical URLs, links in emails). Empty in dev: the request's origin is used.
NUXT_PUBLIC_SITE_URL=

# The database. Defaults to the SQLite file .vitehub/data/database/sqlite.db. A libSQL/Turso URL works too
# (with TURSO_AUTH_TOKEN). `pnpm db:migrate` and the server both read it.
# DATABASE_URL=libsql://your-db.turso.io

# Confirmation emails go through Resend in production. In dev they stay in the outbox (Console > Email).
RESEND_API_KEY=
NUXT_MAIL_FROM="Meetups <hello@meetups.example>"

# Exchange rates. Defaults to frankfurter.dev, which needs no key.
NUXT_RATES_URL=https://api.frankfurter.dev/v1/latest
NUXT_RATES_API_KEY=
