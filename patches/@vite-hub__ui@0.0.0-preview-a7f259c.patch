+
+/* Surfaces inside AgentSession fill the panel and follow its theme, as T3 Code themes its Pierre tree. */
+@layer components {
+  .vh-agent-session__panel-body :is(.vh-file-tree, .vh-diff, .vh-file, .vh-code-view) { border: 0; border-radius: 0; }
+  .vh-agent-session__panel-body .vh-file-tree {
