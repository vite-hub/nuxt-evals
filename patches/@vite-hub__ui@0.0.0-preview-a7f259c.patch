+    .vh-device-frame[data-on]:not([data-dragging]) .vh-device-frame__page { transition: transform 200ms ease-out; }
+  }
+  .vh-device-frame__readout {
+    background: var(--vh-highlighted);
+    border-radius: calc(var(--vh-radius) * 0.75);
+    color: var(--vh-inverted);
+    font-size: 0.75rem;
+    font-variant-numeric: tabular-nums;
+    inset-block-start: 0.5rem;
+    inset-inline-start: 50%;
+    margin: 0;
+    padding: 0.25rem 0.5rem;
+    pointer-events: none;
+    position: absolute;
+    translate: -50% 0;
+  }
+  .vh-device-frame__handle { display: grid; outline: none; place-items: center; position: absolute; touch-action: none; }
+  .vh-device-frame__handle[data-edge="x"] { cursor: ew-resize; height: 100%; inset-block-start: 0; inset-inline-end: -0.75rem; width: 0.75rem; }
+  .vh-device-frame__handle[data-edge="y"] { cursor: ns-resize; height: 0.75rem; inset-block-end: -0.75rem; inset-inline-start: 0; width: 100%; }
+  .vh-device-frame__handle[data-edge="xy"] { cursor: nwse-resize; height: 0.75rem; inset-block-end: -0.75rem; inset-inline-end: -0.75rem; width: 0.75rem; }
+  .vh-device-frame__grip { background: var(--vh-bg-accented); border-radius: 999px; transition: background-color 150ms ease-out; }
+  .vh-device-frame__handle[data-edge="x"] .vh-device-frame__grip { height: 2rem; width: 0.25rem; }
+  .vh-device-frame__handle[data-edge="y"] .vh-device-frame__grip { height: 0.25rem; width: 2rem; }
+  .vh-device-frame__handle:focus-visible .vh-device-frame__grip,
+  .vh-device-frame[data-dragging] .vh-device-frame__grip { background: var(--vh-muted); }
+  .vh-device-frame__handle:focus-visible { outline: 2px solid var(--vh-ring); outline-offset: 2px; }
+  @media (hover: hover) and (pointer: fine) {
+    .vh-device-frame__handle:hover .vh-device-frame__grip { background: var(--vh-muted); }
+  }
+  /* A thumb needs a 44px target; the controls keep their look and grow their hit area. */
+  @media (pointer: coarse) {
+    .vh-device-frame { --vh-device-frame-control: 2.75rem; }
+    .vh-device-frame__handle[data-edge="x"] { inset-inline-end: -1.5rem; width: 1.5rem; }
+    .vh-device-frame__handle[data-edge="y"] { height: 1.5rem; inset-block-end: -1.5rem; }
+    .vh-device-frame__handle[data-edge="xy"] { height: 1.5rem; inset-block-end: -1.5rem; inset-inline-end: -1.5rem; width: 1.5rem; }
+  }
+}
