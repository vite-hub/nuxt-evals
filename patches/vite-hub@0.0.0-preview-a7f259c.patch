+import { n as projectFetch } from "./project-CULWaQ3O.js";
+import { o as consoleResponseError, t as ConsoleNetworkError } from "./request-Ca_yEvN4.js";
+import * as v from "valibot";
+//#region src/console/runtime/client/env-management.ts
+const envPermissionSchema = v.picklist([
+	"inspect",
+	"preview",
+	"replace",
+	"use"
+]);
+const envActorSchema = v.object({
+	id: v.string(),
+	kind: v.picklist([
+		"user",
+		"agent",
+		"service"
+	])
+});
+const envMetadataSchema = v.nullable(v.object({
+	revision: v.string(),
+	updatedAt: v.string(),
+	preview: v.optional(v.string())
+}));
+const envPreviewSchema = v.nullable(v.object({ preview: v.optional(v.string()) }));
+const envInspectionSchema = v.object({
+	metadata: envMetadataSchema,
+	permissions: v.array(envPermissionSchema),
+	admin: v.boolean()
+});
+const envActivitySchema = v.object({ events: v.array(v.object({
+	id: v.string(),
+	operationId: v.string(),
+	key: v.string(),
+	timestamp: v.string(),
+	actor: envActorSchema,
+	action: v.picklist([
+		"inspect",
+		"preview",
+		"replace",
+		"resolve",
+		"use",
+		"grant",
+		"revoke"
+	]),
+	outcome: v.picklist([
+		"started",
+		"succeeded",
+		"failed",
+		"denied"
+	]),
+	revision: v.optional(v.string()),
+	target: v.optional(envActorSchema),
+	permissions: v.optional(v.array(envPermissionSchema)),
+	operation: v.optional(v.string()),
+	traceId: v.optional(v.string()),
+	invocationId: v.optional(v.string())
+})) });
+const envGrantsSchema = v.object({ grants: v.array(v.object({
+	key: v.string(),
+	actor: envActorSchema,
+	permissions: v.array(envPermissionSchema)
+})) });
+async function requestEnvManagement(endpoint, path, action, schema, input = {}) {
+	const body = JSON.stringify({
+		...input,
+		path,
+		action
+	});
+	let response;
+	try {
+		response = await projectFetch(endpoint, {
+			method: "POST",
+			headers: { "content-type": "application/json" },
+			body
+		});
+	} catch (error) {
+		if (error instanceof Error && error.name === "AbortError") throw error;
+		throw new ConsoleNetworkError(error);
+	}
+	if (!response.ok) throw await consoleResponseError(response, response.status === 409 ? { message: "This credential changed. Reload its details before replacing it." } : {});
+	return v.parse(schema, await response.json());
+}
+//#endregion
+export { envMetadataSchema as a, requestEnvManagement as c, envInspectionSchema as i, envActorSchema as n, envPermissionSchema as o, envGrantsSchema as r, envPreviewSchema as s, envActivitySchema as t };
