+      if (/^\d+[a-z]$/i.test(part)) return part.toLocaleUpperCase();
+      return `${part[0]?.toLocaleUpperCase() ?? ""}${part.slice(1)}`;
+    })
+    .join(" ") || "Configured model";
+}
