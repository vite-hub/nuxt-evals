+import { m as consoleOperationOffered, t as allowedConsoleSections } from "./access-TwlKg8BZ.js";
+import { n as consoleOperations } from "./operations-B2LGweBs.js";
+import { i as getConsoleSections, l as consoleOperationRegistry, r as getConsoleProjectName } from "./sections-w8tLQyw3.js";
+//#region src/version.ts
+/** The `vite-hub` package version. The package build and the tests set it; a source checkout without them reads `0.0.0`. */
+const version = "0.1.0";
+//#endregion
+//#region src/console/runtime/server/project.ts
+/** Describe the project for one Console access. `console.authorize` limits the sections and the operations. */
+function readConsoleProject(access) {
+	const installed = getConsoleSections();
+	const sections = allowedConsoleSections(access, installed);
+	const operationSections = import.meta.viteHubConsoleOperationSections ?? installed;
+	const operations = consoleOperationRegistry().list().filter((operation) => !consoleOperations.includes(operation) || typeof operation.section !== "string" || operationSections.includes(operation.section)).filter((operation) => consoleOperationOffered(access, operation)).map((operation) => operation.name);
+	const name = getConsoleProjectName();
+	return {
+		protocol: 1,
+		...name ? { name } : {},
+		vitehub: version,
+		sections,
+		operations
+	};
+}
