+<style>
+/* Usage reads like a dashboard of numbers: text toggles, big tabular figures, hairline rows, and no boxed cards. */
+.usage-page {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 16rem;
+  height: 100%;
+  min-height: 0;
+}
+
+.usage-page__main {
+  display: flex;
+  flex-direction: column;
+  gap: 1.75rem;
+  margin-inline: auto;
+  max-width: 64rem;
+  min-height: 0;
+  overflow-y: auto;
+  padding: 1.25rem 1.5rem 3rem;
+  width: 100%;
+}
+
+.usage-page__controls {
+  align-items: center;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 1rem;
+}
+
+.usage-toggles {
+  display: flex;
+  gap: 1rem;
+}
+
+.usage-toggles button {
+  border-block-end: 1px solid transparent;
+  position: relative;
+  color: var(--ui-text-muted);
+  font-size: 0.8125rem;
+  padding-block: 0.25rem;
+  transition: color 150ms ease, border-color 150ms ease;
+}
+
+/* The text toggles are short. The hit area grows to 40 px tall and stays inside the 1 rem gap to the next one. */
+.usage-toggles button::before {
+  content: "";
+  inset: -0.5rem -0.375rem;
+  position: absolute;
+}
+
+.usage-toggles button:hover {
+  color: var(--ui-text-highlighted);
+}
+
+.usage-toggles button:is([aria-pressed="true"], [aria-current="page"]) {
+  border-block-end-color: var(--ui-text-highlighted);
+  color: var(--ui-text-highlighted);
+}
+
+.usage-toggles button:focus-visible,
+.usage-headline__item:focus-visible,
+.usage-filters button:focus-visible,
+.usage-ranked__name button:focus-visible {
+  border-radius: 0.25rem;
+  outline: 2px solid var(--ui-primary);
+  outline-offset: 2px;
+}
+
+.usage-toggles--small button {
+  font-size: 0.75rem;
+}
+
+.usage-toggles__divider {
+  background: var(--ui-border);
+  height: 1rem;
+  width: 1px;
+}
+
+.usage-headline {
+  display: grid;
+  gap: 1.5rem;
+  grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
+}
+
+.usage-headline__item {
+  display: grid;
+  gap: 0.25rem;
+  justify-items: start;
+  text-align: start;
+}
+
+.usage-headline__label {
+  color: var(--ui-text-muted);
+  font-size: 0.75rem;
+}
+
+.usage-headline__value {
+  color: var(--ui-text-dimmed);
+  font-size: 2.25rem;
+  font-variant-numeric: tabular-nums;
+  font-weight: 400;
+  letter-spacing: -0.02em;
+  line-height: 2.5rem;
+  transition: color 150ms ease;
+}
+
+.usage-headline__item:hover .usage-headline__value,
+.usage-headline__item[aria-pressed="true"] .usage-headline__value {
+  color: var(--ui-text-highlighted);
+}
+
+.usage-headline__item[aria-pressed="true"] .usage-headline__label {
+  color: var(--ui-text-highlighted);
+}
+
+.usage-headline__note {
+  color: var(--ui-text-dimmed);
+  font-size: 0.6875rem;
+}
+
+.usage-page__caption {
+  color: var(--ui-text-dimmed);
+  font-size: 0.75rem;
+  margin-block-start: -1rem;
+}
+
+.usage-share__bar {
+  display: flex;
+  gap: 2px;
+  height: 0.375rem;
+}
+
+.usage-share__bar > span {
+  min-width: 0.25rem;
+  user-select: none;
+}
+
+.usage-share__bar > span:first-child {
+  border-end-start-radius: 9999px;
+  border-start-start-radius: 9999px;
+}
+
+.usage-share__bar > span:last-child {
+  border-end-end-radius: 9999px;
+  border-start-end-radius: 9999px;
+}
+
+.usage-ranked > header {
+  align-items: baseline;
+  display: flex;
+  justify-content: space-between;
+  margin-block-end: 0.5rem;
+}
+
+.usage-ranked h2 {
+  color: var(--ui-text-highlighted);
+  font-size: 0.8125rem;
+  font-weight: 500;
+}
+
+.usage-ranked ol {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.usage-ranked li {
+  align-items: center;
+  border-block-start: 1px solid var(--ui-border);
+  color: var(--ui-text-muted);
+  column-gap: 1rem;
+  display: grid;
+  font-size: 0.8125rem;
+  font-variant-numeric: tabular-nums;
+  grid-template-columns: 1.5rem minmax(0, 1fr) 5rem 7rem 4.5rem;
+  min-height: 2.75rem;
+  padding-block: 0.5rem;
+}
+
+.usage-ranked li > span:nth-child(n + 3) {
+  text-align: end;
+}
+
+.usage-ranked li.usage-ranked__head {
+  border-block-start: 0;
+  color: var(--ui-text-dimmed);
+  font-size: 0.6875rem;
+  min-height: 1.5rem;
+  padding-block: 0;
+}
+
+.usage-ranked__rank {
+  color: var(--ui-text-dimmed);
+  font-size: 0.75rem;
+}
+
+.usage-ranked__name {
+  display: grid;
+  gap: 0.375rem;
+  justify-items: start;
+  min-width: 0;
+}
+
+.usage-ranked__name > :is(button, a, span:not(.usage-ranked__bar)) {
+  color: var(--ui-text-highlighted);
+  max-width: 100%;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.usage-ranked__name > :is(button, a):hover {
+  text-decoration: underline;
+  text-underline-offset: 4px;
+}
+
+.usage-ranked__name small {
+  color: var(--ui-text-dimmed);
+  font-size: 0.6875rem;
+}
+
+.usage-ranked__bar {
+  background: var(--ui-text-highlighted);
+  pointer-events: none;
+  border-radius: 9999px;
+  height: 2px;
+  max-width: 12rem;
+}
+
+.usage-filters {
+  border-inline-start: 1px solid var(--ui-border);
+  display: flex;
+  flex-direction: column;
+  gap: 1.5rem;
+  min-height: 0;
+  overflow-y: auto;
+  padding: 1rem 1rem 2rem;
+}
+
+.usage-filters h2 {
+  align-items: baseline;
+  color: var(--ui-text-highlighted);
+  display: flex;
+  font-size: 0.8125rem;
+  font-weight: 500;
+  gap: 0.375rem;
+  margin-block-end: 0.375rem;
+}
+
+.usage-filters h2 small {
+  color: var(--ui-text-dimmed);
+  font-size: 0.6875rem;
+  font-variant-numeric: tabular-nums;
+  font-weight: 400;
+}
+
+.usage-filters ul {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.usage-filters li button {
+  align-items: center;
+  color: var(--ui-text-muted);
+  display: flex;
+  font-size: 0.8125rem;
+  gap: 0.5rem;
+  min-height: 2rem;
+  text-align: start;
+  transition: color 150ms ease;
+  width: 100%;
+}
+
+.usage-filters li button:hover,
+.usage-filters li button[aria-pressed="true"] {
+  color: var(--ui-text-highlighted);
+}
+
+.usage-filters__check {
+  border: 1px solid var(--ui-border-accented);
+  border-radius: 0.1875rem;
+  flex: none;
+  height: 0.75rem;
+  width: 0.75rem;
+}
+
+[aria-pressed="true"] > .usage-filters__check {
+  background: var(--ui-text-highlighted);
+  border-color: var(--ui-text-highlighted);
+}
+
+.usage-filters__name {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.usage-filters__count {
+  color: var(--ui-text-dimmed);
+  font-size: 0.75rem;
+  font-variant-numeric: tabular-nums;
+}
+
+.usage-filters__clear {
+  align-self: start;
+  color: var(--ui-text-muted);
+  font-size: 0.75rem;
+  text-decoration: underline;
+  text-underline-offset: 4px;
+}
+
+.usage-filters__note {
+  border-block-start: 1px solid var(--ui-border);
+  color: var(--ui-text-dimmed);
+  font-size: 0.6875rem;
+  line-height: 1.5;
+  padding-block-start: 1rem;
+}
+
+/* A narrow screen stacks the filters under the numbers, and the whole page scrolls. */
+@media (max-width: 64rem) {
+  .usage-page {
+    display: block;
+    overflow-y: auto;
+  }
+
+  .usage-page__main,
+  .usage-filters {
+    overflow: visible;
+  }
+
+  .usage-filters {
+    border-block-start: 1px solid var(--ui-border);
+    border-inline-start: 0;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .usage-toggles button,
+  .usage-headline__value,
+  .usage-filters li button {
+    transition: none;
+  }
+}
+</style>
